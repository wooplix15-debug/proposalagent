# Wooplix Proposal Agent — environment file
# Copy this file to ".env" (same folder) and fill in your real values.
# NEVER commit or share the filled-in ".env". It holds live secrets.

# --- Required: the language model ---
GROQ_API_KEY=
# Optional. Leave blank to use the default. Confirm the model is available on
# your key with:  curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional: Zoho CRM precedent + WorkDrive upload ---
# Without these the agent still works; it just skips CRM precedent and upload.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# India data centre by default. Change if your Zoho account is in another DC.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Module the agent reads for past-proposal precedent.
ZOHO_CRM_MODULE=Deals
# WorkDrive folder id to upload finished files into ("root" = your root folder).
ZOHO_WORKDRIVE_FOLDER_ID=root

# Optional signing secret for the web analysis and answer flow.
# Use a long random server-side value. If blank, the server uses GROQ_API_KEY.
WORKFLOW_SIGNING_SECRET=

# Local LangGraph checkpoint database. No database server is required locally.
LANGGRAPH_SQLITE_PATH=.state/wooplix.sqlite
LANGGRAPH_STORAGE=sqlite
# Vercel: use LANGGRAPH_STORAGE=postgres and paste both Neon connection strings.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional Telegram bot: create one with @BotFather and paste its token here.
# Polling starts with the local FastAPI server when a token is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_ENABLED=1
TELEGRAM_AGENT_BASE_URL=http://127.0.0.1:8001
TELEGRAM_STATE_PATH=.state/telegram.sqlite
# Optional comma-separated private chat/user IDs. Empty accepts private chats.
TELEGRAM_ALLOWED_CHAT_IDS=

# Vercel: webhook mode, polling disabled, random secret for Telegram's header.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=Proposalwooplix_bot
# Optional outside Vercel; deployment URLs are detected automatically on Vercel.
APP_BASE_URL=
# Random bearer token for the Vercel PHP/Dompdf renderer.
PDF_RENDER_TOKEN=
